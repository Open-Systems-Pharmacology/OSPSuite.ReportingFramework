linters: linters = {
    source("tools/custom-linters.R")
    linters_with_defaults(
      object_name_linter = NULL,
      line_length_linter = NULL,
      object_length_linter = NULL,
      brace_linter = NULL,
      paren_body_linter = NULL,
      trailing_whitespace_linter = NULL,
      trailing_blank_lines_linter = NULL,
      spaces_left_parentheses_linter = NULL,
      infix_spaces_linter = NULL,
      vector_logic_linter = NULL,
      indentation_linter = NULL,
      object_name_linter(styles = c("camelCase", "symbols")),
      undesirable_function_linter = undesirable_function_linter(c(
        "round" = "Use janitor::round_half_up() instead of round().",
        "signif" = "Use janitor::signif_half_up() instead of signif()."
      )),
      cyclocomp_linter(complexity_limit = 15),
      roxygenRequiredLinter = roxygenRequiredLinter(),
      roxygenDetailsForComplexLinter = roxygenDetailsForComplexLinter(limit = 10),
      internalFunctionRulesLinter = internalFunctionRulesLinter(),
      internalFunctionReturnLinter = internalFunctionReturnLinter()
    )
  }
exclusions: list(
  "inst/templates",
  "inst/doc",
  "inst/extdata/Tutorial"
  )
encoding: "UTF-8"

