Name: Open Template Workflow
Description: Open a template script for the default workflow
Binding: openWorkflowTemplate
Interactive: false

Name: Open Template ePackage Workflow RMD
Description: Open a template rmarkdown for a workflow developing for the ePackage
Binding: openEPackageTemplate
Interactive: false

Name: Open Template Plotfunction
Description: Open a template function for a user-defined plotfunction
Binding: openFigureTemplate
Interactive: false

Name: Open AI Workflow Prompt
Description: Print an AI-ready prompt for creating or refining a workflow
Binding: openAIWorkflowPrompt
Interactive: false

Name: Open AI Import Data Prompt
Description: Print an AI-ready prompt focused on data import and dictionaries
Binding: openAIImportDataPrompt
Interactive: false

Name: Open AI Build Plots Prompt
Description: Print an AI-ready prompt focused on plot setup and generation
Binding: openAIBuildPlotsPrompt
Interactive: false

Name: Open AI Debug Run Prompt
Description: Print an AI-ready prompt focused on troubleshooting workflow runs
Binding: openAIDebugRunPrompt
Interactive: false

